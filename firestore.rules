rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Files Collection
    match /files/{fileId} {
      // Anyone can view files (required for public view route)
      allow read: if true;
      // Authenticated (non-anonymous) users can create files, but must set themselves as the owner
      allow create: if request.auth != null && 
                       request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                       request.resource.data.uid == request.auth.uid;
      // Only the owner can update or delete their file
      allow update, delete: if request.auth != null && 
                            request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                            resource.data.uid == request.auth.uid;
    }

    // 2. Vector Search Index (AppView)
    match /matadisco_index/{docId} {
      // Anyone can query the index for search
      allow read: if true;
      // Explicitly block client writes. This collection should ONLY be written to
      // by the Jetstream consumer/Cloud Functions via the Admin SDK.
      allow write: if false; 
    }

    // 3. User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && 
                                       request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                                       request.auth.uid == userId;
    }

    // 4. Usernames Registry
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && 
                       request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                       request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && 
                            request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                            resource.data.uid == request.auth.uid;
    }
  }
}