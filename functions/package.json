{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "rm -rf lib && tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "engines": {
    "node": "20"
  },
  "type": "module",
  "dependencies": {
    "@atproto/api": "^0.19.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@gltf-transform/core": "3.0.2",
    "@gltf-transform/extensions": "3.0.2",
    "@gltf-transform/functions": "3.0.2",
    "@google-cloud/firestore": "4.4.0",
    "@google-cloud/functions-framework": "^5.0.2",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/storage": "6.9.4",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^1.50.1",
    "@ipld/car": "^5.2.4",
    "cors": "2.8.5",
    "draco3dgltf": "1.5.6",
    "express": "^5.2.1",
    "extract-zip": "2.0.1",
    "ffmpeg-static": "5.1.0",
    "ffprobe": "1.1.2",
    "ffprobe-static": "3.1.0",
    "files-from-path": "^1.0.4",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.0.0",
    "firebase-tools": "8.4.3",
    "fluent-ffmpeg": "2.1.2",
    "ipfs-car": "^3.1.0",
    "node-fetch": "2.6.6",
    "puppeteer": "18.1.0",
    "sharp": "0.34.5",
    "url-join": "4.0.1",
    "w3name": "^1.1.3",
    "yn": "5.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-promise": "4.0.1",
    "firebase-functions-test": "0.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^4.9.0"
  },
  "private": true,
  "main": "lib/index.js"
}
