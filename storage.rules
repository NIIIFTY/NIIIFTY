rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    match /{fileId}/{fileName=**} {
      // Public read access for assets
      allow read: if true;
      
      // Allow creation if the corresponding Firestore document doesn't exist yet (new upload flow),
      // OR if it does exist, the user must be the owner.
      // Must be non-anonymous authenticated user.
      allow create: if request.auth != null && 
                       request.auth.token.firebase.sign_in_provider != 'anonymous' && (
        !firestore.exists(/databases/(default)/documents/files/$(fileId)) ||
        firestore.get(/databases/(default)/documents/files/$(fileId)).data.uid == request.auth.uid
      );
      
      // Prevent updating or deleting existing files unless they own the corresponding firestore doc
      allow update, delete: if request.auth != null && 
                            request.auth.token.firebase.sign_in_provider != 'anonymous' &&
                            firestore.get(/databases/(default)/documents/files/$(fileId)).data.uid == request.auth.uid;
    }
  }
}
