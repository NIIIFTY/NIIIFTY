{
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:functions && pnpm build:appview && next build",
    "build:functions": "pnpm --prefix functions build",
    "build:appview": "pnpm --prefix appview build",
    "start": "next start",
    "deploy": "pnpm deploy:firebase && pnpm deploy:appview",
    "deploy:firebase": "pnpm build:functions && firebase deploy --only firestore,storage,functions",
    "deploy:functions": "pnpm build:functions && firebase deploy --only functions",
    "deploy:appview": "gcloud run deploy matadisco-consumer --source ./appview --region europe-west1 --min-instances 1 --max-instances 1 --set-env-vars GCLOUD_PROJECT=niiifty-bd2e2 --no-allow-unauthenticated",
    "emulate": "pnpm build:functions && firebase emulators:start",
    "atproto:delete": "node scripts/delete-atproto-record.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.2",
    "@headlessui/react": "^1.6.6",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.3.1",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.7.0",
    "i18next": "^25.6.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.546.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-firebase-hooks": "5.0.3",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.1.4",
    "react-quill": "2.0.0-beta.2",
    "react-select": "^5.10.2",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "striptags": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "url-join": "^5.0.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@atproto/api": "^0.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.7",
    "dotenv": "^17.4.2",
    "eslint-config-next": "15.5.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
